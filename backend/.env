# Server Configuration
PORT=3333

# JWT Secret Key 
SECRETKEY='sua_chave_secreta_aqui'

# Database Connection
# (Substitua 'SUA_SENHA_AQUI' pela sua senha do postgres)
# (O 'univet_db' é uma sugestão de nome para o banco, você pode mudar se quiser)
DATABASE_URL="postgresql://postgres:root@localhost:5432/univet_db"

# (Opcional, mas bom para testes)
TEST_DATABASE_URL="postgresql://postgres:root@localhost:5432/univet_test_db"