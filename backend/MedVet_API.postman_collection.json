                "exec": [
                  "const response = pm.response.json();",
                  "if (response.clinica && response.clinica.id) {",
                  "    pm.collectionVariables.set('clinica_id', response.clinica.id);",
                  "    pm.environment.set('clinica_id', response.clinica.id);",
                  "}"
