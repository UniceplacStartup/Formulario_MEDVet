            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnpj\": \"12345678000199\",\n  \"razao_social\": \"Clínica Veterinária Exemplo LTDA\",\n  \"nome_fantasia\": \"VetCare\",\n  \"telefone\": \"11987654321\",\n  \"email\": \"contato@vetcare.com.br\",\n  \"crmv\": \"SP-12345\"\n}"
